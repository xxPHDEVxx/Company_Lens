# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
# For PostgreSQL in production:
# DATABASE_URL=postgres://user:password@localhost:5432/company_lens_db
# For SQLite in development (default if not set)
DATABASE_URL=sqlite:///db.sqlite3

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=60  # minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # days

# Email Settings (optional for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# External API Keys (for Belgian company data if needed)
KBO_API_KEY=
CROSSROADS_BANK_API_KEY=

# Celery and RabbitMQ Configuration
CELERY_BROKER_URL=amqp://admin:admin123@localhost:5672/company_lens
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# For testing without RabbitMQ (synchronous execution)
CELERY_ALWAYS_EAGER=False

# AI Scraper Configuration
AI_SCRAPER_ENABLED=False
AI_SCRAPER_API_KEY=your-api-key-here
AI_SCRAPER_BASE_PATH=../ai
AI_SCRAPER_TIMEOUT=120